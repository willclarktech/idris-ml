# test-examples-convergence threshold expectations
#
# Format: <target> <key> <op> <threshold>
# Same syntax as test-examples.expect — see that file's header for details.
#
# CONVERGENCE-LEVEL THRESHOLDS: tight thresholds that require the model to
# actually learn. Used by `make test-examples-convergence` which runs every
# example to convergence at full default epochs (single seed=42, tape only).
# See docs/develop/testing.md for the testing-layer overview.

# ---- Supervised / recurrent / transformer ----
example-supervised               loss         <   0.5
example-rnn                      loss         <   0.5
example-lstm                     loss         <   0.05
example-gru                      loss         <   0.05
example-transformer              sort_acc     >=  0.8

# ---- Other non-RL ----
example-mnist                    accuracy     >=  0.85
# Gated on held-out accuracy, not training loss: the reference's own bar is
# `accuracy > 0.5` (chance is 0.33) and both sides now report both metrics.
example-seq-classify             accuracy     >=  0.5
# Default `make example-gpt` is now embedded/30 (~30s); RESULT emits `bpc`
# (training-corpus). The full convergence target lives in `example-gpt-full`
# (--corpus tinyshakespeare --epochs 1000), with val_bpc < 3.5 as the
# documented expectation — not run from this loop because it takes hours.
example-gpt                      bpc          <   5.0
example-transfer                 loss         <   0.5

# ---- Memory-augmented (NTM/DNC at full default 50K-100K epochs) ----
# ntm-copy gates on `acc_full` (len 1-20), which is the trained range and is
# exactly what the row measured as plain `acc` before 2026-07-31 — the key was
# renamed to match the reference's short/full split, not the measurement.
#
# Both bars are PER SEED: they answer "did this seed converge", not "must every
# seed pass". Measured 2026-08-01 over seeds 42/1/2/3/4, pooled across both
# implementations:
#
#   ntm-recall   converged 0.94-0.996    failed 0.687-0.781
#   ntm-copy     converged 0.993-1.0     failed 0.674-0.795
#
# The distribution is bimodal with nothing in between, and each bar sits in
# that gap — a run either learns the task or lands near 0.7. Lowering them
# would let a non-converged run register as a pass, so they stay where they
# are. The multi-seed expectation is a PASS RATE, against the reference's own
# measured rate per the alignment policy ("use PyTorch's pass rate as the
# target"), recorded in reference-alignment.md:
#
#   ntm-copy     idris 3/5   reference 4/5
#   ntm-recall   idris 2/5   reference 3/5
#
# Seed 4 fails on both sides of both tasks. `make test-convergence` uses seed
# 42 only, which converges on both.
example-ntm-copy                 acc_full     >=  0.9
example-ntm-associative-recall   acc          >=  0.8
example-dnc-copy                 acc          >=  0.8
example-dnc-recall               acc          >=  0.6

# ---- RL: tabular ----
example-q-learning               avg_return   >=  -120
example-sarsa                    avg_return   >=  -120
example-monte-carlo              win_rate     >=  0.3
# Slippery 4x4 FrozenLake: even an optimal policy slips into holes ~30% of
# the time, so avg_return is success-rate-capped well below 1.0.
example-frozen-lake              avg_return   >=  0.4
# Taxi-v4: deterministic, fixed start. Optimal trajectory is 13 actions
# (12 steps × -1, +20 dropoff) → +8 reward. Threshold allows slight slack
# for sub-optimal Q-tables; trained policy reliably hits 8.
example-taxi                     avg_return   >=  5

# ---- RL: deep (CartPole + Acrobot + Pendulum) ----
# CartPole: REINFORCE/A2C aim for ~500; DQN ~100+ at convergence.
# Acrobot: PPO solves at ~-100 (near-optimal); seed=42 reaches -94.
# Pendulum: SAC at full convergence aims for ~-500; documented partial level.
example-reinforce                avg_return   >=  150
example-dqn                      avg_return   >=  100
# Double DQN: peer bar with dqn. The paired PyTorch reference's own test
# requires >= 3/5 seeds at >= 150 greedy eval, so 100 is the conservative
# side of the reference. Added 2026-07-29 — the row was missing since the
# example landed (2026-06-19), and check-result.sh treats a missing row as
# presence-only, so campaign cells recorded "pass" without checking anything.
example-double-dqn               avg_return   >=  100
example-mountain-car             avg_return   >=  -160
example-mountain-car-cont        avg_return   >=  85
example-a2c                      avg_return   >=  150
example-ppo                      avg_return   >=  -150
example-sac                      avg_return   >=  -500
