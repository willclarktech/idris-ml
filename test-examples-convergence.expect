# test-examples-convergence threshold expectations
#
# Format: <target> <key> <op> <threshold>
# Same syntax as test-examples.expect — see that file's header for details.
#
# CONVERGENCE-LEVEL THRESHOLDS: these are the tight thresholds the smoke
# gate (test-examples.expect) used to use before the crash-only collapse.
# They require the model to actually learn — appropriate for the slow lanes
# that run at full default epoch counts.
#
# Used by:
#   - test-examples-convergence-supervised (non-RL fast-converging set, single seed=42)
#   - (eventually) test-examples-convergence (RL multi-seed) once that target is
#     migrated off test-examples.expect

# ---- Supervised / recurrent ----
example-supervised               loss         <   0.5
example-rnn                      loss         <   0.5
example-lstm                     loss         <   0.7
example-transformer              sort_acc     >=  0.8

# ---- Other non-RL ----
# Calibrate empirically — placeholders below; first clean run sets them
example-mnist                    accuracy     >=  0.85
example-seq-classify             loss         <   0.5
example-gpt                      bpc          <   3.5
example-transfer                 loss         <   0.5

# ---- Memory-augmented (test-examples-convergence-memory) ----
# Original tight thresholds before the smoke collapse. NTM/DNC at default
# 50K-100K epochs takes hours; only the manual memory-convergence target
# uses these.
example-ntm-copy                 acc_short    >=  0.9
example-ntm-associative-recall   acc_k2       >=  0.8
example-dnc-copy                 acc_short    >=  0.8
example-dnc-recall               acc_k2       >=  0.6
