||| Build-time selection of the (device, dtype) pair that examples
||| target. Generated from this template by the Makefile rule at
||| `Makefile`'s BUILDCONFIG_IDR target: when `PRIMARY=mlx` and
||| `MLX_DEVICE=gpu`, examples get `(MlxDev MGpu)` + `F32`; everything
||| else defaults to `CPU` + `F64`.
|||
||| Idris-2 cannot drive type-level selection from a runtime env var —
||| types are fixed at elaboration time, before `main`. The Makefile
||| observes the env at build time and substitutes the chosen tags
||| into this template via sed; the generated `BuildConfig.idr` is in
||| `.gitignore`.
|||
||| Do not edit `BuildConfig.idr` directly — your changes will be
||| clobbered on the next build. Edit this `.in` file instead.
module BuildConfig

import Device
import Device.Mlx

||| Device tag examples target. `CPU` by default; `MlxDev MGpu` when
||| building with `BACKEND=mlx MLX_DEVICE=gpu`.
public export
ExampleDevice : Type
ExampleDevice = @DEVICE@

||| DType examples target. `F64` by default; `F32` when building with
||| `BACKEND=mlx MLX_DEVICE=gpu` (Metal GPU dropped f64 support in
||| mlx 0.31).
public export
ExampleDType : DType
ExampleDType = @DTYPE@
