package idris-gym-tests

-- Tests ipkg pointed at the same sourcedir as the library ipkg. The
-- library's `modules = ...` list excludes Test.* so consumers only
-- see library modules; this tests ipkg builds the Test.* tree.
-- See docs/develop/testing.md ("colocated-tests dual-ipkg pattern").
sourcedir = "src"

depends = contrib
        , idris-gym
        , idris-test

modules = Test.Main
        , Test.Rng
        , Test.Space
        , Test.Wrapper
        , Test.Vector
        , Test.ClassicControl.CartPole
        , Test.ClassicControl.MountainCar
        , Test.ClassicControl.MountainCarCont
        , Test.ClassicControl.Pendulum
        , Test.ClassicControl.Acrobot
        , Test.ToyText.CliffWalking
        , Test.ToyText.Taxi
        , Test.ToyText.FrozenLake
        , Test.ToyText.Blackjack

main = Test.Main

executable = idris-gym-test
