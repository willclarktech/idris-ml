package idris-transformers-tests

-- Tests ipkg pointed at the same sourcedir as the library ipkg. The
-- library's `modules = ...` list excludes Test.* so consumers only
-- see library modules; this tests ipkg builds the Test.* tree.
-- See docs/develop/testing.md ("colocated-tests dual-ipkg pattern").
sourcedir = "src"

depends = contrib
        , idris-ml
        , idris-transformers
        , idris-test

modules = Test.Main
        , Test.HfBert
        , Test.HfBertAttentionMask
        , Test.HfBertForClassification
        , Test.HfBitNet
        , Test.HfGpt2
        , Test.HfLlama
        , Test.KVCache
        , Test.Tokenizer

main = Test.Main

executable = idris-transformers-test
