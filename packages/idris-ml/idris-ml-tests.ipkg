package idris-ml-tests

-- Tests ipkg pointed at the same sourcedir as the library ipkg. The
-- library's `modules = ...` list excludes Test.* so consumers (pack,
-- downstream packages) only see library modules; this tests ipkg
-- exclusively builds the Test.* tree.
-- See docs/develop/testing.md ("colocated-tests dual-ipkg pattern").
sourcedir = "src"

depends = contrib
        , elab-util
        , hedgehog
        , idris-ml
        , idris-test

modules = Test.Main
        , Test.ActivationDump
        , Test.Config
        , Test.Array
        , Test.Backend
        , Test.CheckpointSubset
        , Test.Construct
        , Test.Data
        , Test.Fit
        , Test.GradMode
        , Test.GradScaler
        , Test.Hpo.LrFinder
        , Test.Init
        , Test.LoadOpts
        , Test.Log
        , Test.Lossless
        , Test.ManagedHandle
        , Test.Math
        , Test.MlSimple
        , Test.Nn.Activation
        , Test.Nn.BatchNorm
        , Test.Nn.BitLinear
        , Test.Nn.Conv
        , Test.Nn.Derive
        , Test.Nn.Dnc
        , Test.Nn.Dropout
        , Test.Nn.Embedding
        , Test.Nn.Equivalence
        , Test.Nn.Freeze
        , Test.Nn.Group
        , Test.Nn.Gru
        , Test.Nn.Init
        , Test.Nn.LayerNorm
        , Test.Nn.Linear
        , Test.Nn.LinearMixed
        , Test.Nn.LoraLinear
        , Test.Nn.Lstm
        , Test.Nn.Module
        , Test.Nn.Ntm
        , Test.Nn.Pool
        , Test.Nn.PosEncoding
        , Test.Nn.Residual
        , Test.Nn.Recurrent
        , Test.Nn.RmsNorm
        , Test.Nn.RoPE
        , Test.Nn.Seq
        , Test.Nn.SwiGLU
        , Test.Nn.Transformer
        , Test.Optimizer
        , Test.Properties.F32GradParity
        , Test.Properties.GoldenDemo
        , Test.Properties.Reshape
        , Test.Properties.RmsNorm
        , Test.Properties.RoPE
        , Test.Properties.Softmax
        , Test.SaveModelMatching
        , Test.RL.Gae
        , Test.RL.ReplayBuffer
        , Test.Sampler
        , Test.Schedule
        , Test.TensorExpr
        , Test.TrainEngine

main = Test.Main

executable = test
