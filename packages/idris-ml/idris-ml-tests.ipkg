package idris-ml-tests

-- Tests ipkg pointed at the same sourcedir as the library ipkg. The
-- library's `modules = ...` list excludes Test.* so consumers (pack,
-- downstream packages) only see library modules; this tests ipkg
-- exclusively builds the Test.* tree.
-- See docs/develop/testing.md ("colocated-tests dual-ipkg pattern").
sourcedir = "src"

depends = contrib
        , hedgehog
        , idris-ml
        , idris-test

modules = Test.Main
        , Test.ActivationDump
        , Test.Config
        , Test.Array
        , Test.Backend
        , Test.BitLinear
        , Test.BitNet
        , Test.CheckpointSubset
        , Test.Construct
        , Test.Data
        , Test.Fit
        , Test.GradMode
        , Test.GradScaler
        , Test.Hpo.LrFinder
        , Test.Init
        , Test.LoadOpts
        , Test.Log
        , Test.Lossless
        , Test.LoraLinear
        , Test.ManagedHandle
        , Test.Math
        , Test.Nn.Init
        , Test.Nn.Module
        , Test.Nn.Seq
        , Test.MixedLayerLike
        , Test.Optimizer
        , Test.Properties.F32GradParity
        , Test.Properties.GoldenDemo
        , Test.Properties.Reshape
        , Test.Properties.RmsNorm
        , Test.Properties.RoPE
        , Test.Properties.Softmax
        , Test.RmsNorm
        , Test.RoPE
        , Test.SaveModelMatching
        , Test.SwiGLU
        , Test.RL.Gae
        , Test.RL.ReplayBuffer
        , Test.Sampler
        , Test.Schedule
        , Test.TensorExpr
        , Test.TrainEngine

main = Test.Main

executable = test
