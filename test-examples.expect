# test-examples threshold expectations
#
# Format: <target> <key> <op> <threshold>
#
# <key>       is one of the key=value fields emitted by `formatResult` in Train.idr.
#             If a value looks like "N/M" it's auto-converted to the ratio N/M before compare.
# <op>        shell-style numeric comparison: <, <=, >, >=, ==, !=
# <threshold> a number (float or int). Compared as: (value $op threshold).
#
# Lines starting with # are ignored. Blank lines are ignored.
# Missing a target from this file means "presence-only" (no threshold check).
#
# CRASH-ONLY SMOKE PHILOSOPHY: test-examples runs each example for 3-10 epochs
# (see Makefile EXAMPLE_* overrides). Thresholds here catch:
#   - NaN losses / divergence to extreme values (any NaN compare returns false)
#   - missing or renamed RESULT keys (key-not-found fails the row)
#   - total breakdown ("loss > 1e10", "return < -10000")
# Thresholds do NOT require the model to learn anything meaningful at this
# epoch count. Convergence regressions are caught by test-examples-convergence
# (RL multi-seed) and any future full-config lane.
#
# Tabular RL (q-learning/sarsa/monte-carlo) is the exception: those run at
# their full default epoch count (already fast) and use convergence-level
# thresholds.

# ---- Supervised / recurrent: safety-net (5 epochs) ----
example-supervised               loss         <   5.0
example-rnn                      loss         <   5.0
example-lstm                     loss         <   5.0
example-gru                      loss         <   5.0

# ---- Transformer at 5 epochs is well below random sort_acc threshold —
# leave the row out so it's presence-only (RESULT line is enough)
# example-transformer            sort_acc     >=  0.8

# ---- Smoke (a few epochs): safety-net thresholds ----
example-gpt                      bpc          <   20.0
example-mnist                    accuracy     >=  0.05
example-seq-classify             loss         <   10.0
# Matmul bench: presence-only — RESULT line has no loss/accuracy, just
# perf numbers. Throughput must be > 0 to catch a totally-broken matmul.
example-matmul-bench             gflops       >   0.1

# ---- Memory-augmented nets: safety-net (5 epochs) ----
# At 5 epochs none of these have learned past random (~0.5 for binary tasks).
# Threshold 0.3 catches "totally diverged" without flaking on init/seed noise.
example-ntm-copy                 acc          >=  0.3
example-ntm-associative-recall   acc          >=  0.3
example-dnc-copy                 acc          >=  0.3
example-dnc-recall               acc          >=  0.3

# ---- RL: tabular (full convergence) ----
# These run at their default epoch count (already fast) — keep tight thresholds.
example-q-learning               avg_return   >=  -120
example-sarsa                    avg_return   >=  -120
example-monte-carlo              win_rate     >=  0.3
example-frozen-lake              avg_return   >=  0.4
example-taxi                     avg_return   >=  5

# ---- RL: deep (safety-net at very reduced caps) ----
# CartPole (REINFORCE/DQN/A2C) random ≈ 22; Acrobot (PPO) random ≈ -500;
# Pendulum (SAC) random ≈ -1500.
# All thresholds here are NaN/divergence catches, not convergence claims.
# mountain-car-cont: at 5 smoke epochs SAC is still inside its
# 1000-step warmup, so the eval measures the untrained actor
# (≈ -9.4 tape / -5.3 mlx / -1.8 mlx-gpu). Worst non-diverged return
# is ≈ -100 (999 steps × -0.1·a²); the old -1.0 was a learning claim
# left over from before the example came off the harness skip list.
example-reinforce                avg_return   >=  -100
example-dqn                      avg_return   >=  -300
example-double-dqn               avg_return   >=  -300
example-mountain-car             avg_return   >=  -201
example-mountain-car-cont        avg_return   >=  -120
example-a2c                      avg_return   >=  -100
example-ppo                      avg_return   >=  -550
example-sac                      avg_return   >=  -2500

# ---- Cross-backend transfer ----
example-transfer                 loss         <   5.0
example-transfer-demo            loss         <   5.0

# ---- F32/F64 precision + cross-backend hop ----
# String compare via awk: overall=ok passes; anything else (FAIL / pending)
# fails the row, surfacing precision or hop regressions explicitly.
example-precision-demo           overall      ==  ok
