# clang-tidy config for the C / C++ backend sources.
#
# Architecture: deny-list. Enable everything (`*`), then disable
# families and individual checks that don't carry bug-class signal
# for this codebase. The disable list is long but written once with
# rationales; new checks shipped in future LLVM versions are
# automatically enabled.
#
# To opt one of the disabled families back in: remove its entry
# below, run `make lint-c-tape`, triage the findings (fix or NOLINT).
# The rationale block on each disable says why we decided against
# it the first time around.
#
# Family-wholesale disables:
#   android-*      — Android-specific (e.g. android-cloexec-fopen wants
#                    fopen mode 'e' for O_CLOEXEC); we target desktop
#                    macOS/Linux and macOS fopen doesn't accept 'e'
#   clang-analyzer-optin.taint.* — taint analysis treats every file read
#                    as attacker-controlled and flags the downstream
#                    malloc size / array index. safetensors.c + idx.c load
#                    the user's own checkpoints + datasets (trusted input),
#                    so the taint model doesn't fit; it also drives the
#                    "tainted index" variant of clang-analyzer-security.
#                    ArrayBound, which goes away with the family disabled.
#   altera-*       — Intel Altera FPGA OpenCL optimization hints; we
#                    target CPU
#   abseil-*       — Abseil library; not a dep
#   boost-*        — Boost library; not a dep
#   concurrency-*  — `getenv` flagged as MT-unsafe; the backend is
#                    single-threaded
#   cppcoreguidelines-* — C++ guidance; primarily a C codebase, the
#                    C-applicable parts (init-variables, magic-numbers)
#                    are stylistic noise
#   darwin-*       — Darwin-specific (dispatch_once etc.); narrow
#                    surface
#   fuchsia-*      — Fuchsia OS style; opinionated
#   google-*       — Google style; overlaps with hicpp/llvm
#   hicpp-*        — High Integrity C++; signed-bitwise fires on
#                    legitimate array indexing
#   linuxkernel-*  — Linux kernel coding patterns; N/A
#   llvm-*         — LLVM project's own coding style; header guard
#                    naming + include-order are stylistic
#   llvmlibc-*     — Intended for LLVM's own libc implementation
#   modernize-*    — C++11/14/17/20 modernization; primarily a C
#                    codebase
#   mpi-*          — MPI; N/A
#   objc-*         — Objective-C; N/A
#   openmp-*       — OpenMP; N/A
#   zircon-*       — Fuchsia Zircon kernel; N/A
#
# Individual-check disables (within otherwise-enabled families):
#   bugprone-branch-clone — FALSE POSITIVE on this codebase's dtype
#       dispatch. Fires on `switch`/`if` whose arms are structurally
#       parallel but semantically distinct (e.g. `case 13: dt =
#       mx::float16; break; case 14: dt = mx::float32; break;` — the check
#       treats `dt = <X>; break;` as a clone regardless of the differing
#       RHS), and on if/else whose bodies differ only by one extra
#       statement. Every hit (device select, 4 dtag->Dtype dispatches,
#       the RMSprop momentum branch) was confirmed distinct. Carries no
#       bug-class signal here.
#   bugprone-easily-swappable-parameters — tensor APIs are full of
#       `(int m, int n)` adjacent parameter pairs by necessity
#   bugprone-multi-level-implicit-pointer-conversion — fires ~25× in
#       safetensors.c on idiomatic C `char**`/`const char**` -> `void*`
#       passing (cJSON + FFI marshalling). In C any object pointer
#       converts to void* implicitly; the "multilevel" warning is a
#       C++-flavoured style nit that carries no bug-class signal for this
#       C marshalling code, and explicit (void*) casts at every site would
#       be pure clutter.
#   bugprone-reserved-identifier — `_var` is the local convention for
#       tape-internal helpers and statement-expression locals
#   cert-dcl37-c, cert-dcl51-cpp — aliases of bugprone-reserved-identifier
#   cert-err33-c — predicted 41 hits across the backend, all
#       `fprintf(stderr, ...)` discards in diagnostic-logging paths;
#       wrong noise:signal ratio
#   cert-msc30-c, cert-msc50-cpp, clang-analyzer-security.insecureAPI.rand
#       — flag rand() as a poor/insecure RNG. The dropout + seeded-shuffle
#       paths (shared_utils.c) use rand()/srand() DELIBERATELY: dropout
#       masks are non-cryptographic and need a process-global seedable
#       generator for reproducible training, which arc4random (the
#       suggested replacement) can't provide. Intentional, not a bug.
#   clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#       — "use fprintf_s instead of fprintf" (C11 Annex K, not widely
#       shipped); ~41 FPs for plain fprintf calls
#   misc-include-cleaner — disabled in the deny-list, but exercised
#       by `make lint-c-include-cleaner` (and the matching CI step)
#       as a SEPARATE gate that runs WITHOUT `-include rename_tape.h`.
#       The rename machinery preprocessor-rewrites every backend.h
#       symbol (tensor_*, param_*, ...) before include-cleaner sees
#       them, which hides ~250 providers and produces architectural
#       FPs against the renamed view. The rename-free gate sees the
#       source as written, which is what include-cleaner is designed
#       to check, and currently runs zero hits on backend_tape after
#       the cleanup in da63ac03. The cleanup uses IWYU trailing
#       pragmas (`// IWYU pragma: keep`) for umbrella/macro-provider
#       false positives (Accelerate.h, _kernels.inc transitives) and
#       per-call `// NOLINTNEXTLINE(misc-include-cleaner)` for the
#       macOS Apple SDK abort+BLAS FPs that don't exist on Linux.
#   readability-braces-around-statements — `misleading-indentation`
#       already catches the goto-fail class without forcing braces
#       everywhere
#   readability-function-cognitive-complexity — stylistic; some
#       backward fns are intrinsically long
#   readability-identifier-length — `i`/`j`/`m`/`n`/`eps` are idiomatic
#       in math code
#   readability-inconsistent-declaration-parameter-name — header
#       decls use generic placeholders (`TensorHandle t`); .c files
#       use mnemonic names (`ha`, `hweight`); intentional convention
#   readability-isolate-declaration — `int a, b;` is fine
#   readability-magic-numbers — stylistic
#   readability-math-missing-parentheses — operator precedence is
#       well-defined
#   readability-non-const-parameter — partly C-doesn't-have-const-views
#   readability-redundant-casting — sometimes intentional for clarity
#   readability-redundant-declaration — backend.h is the Idris FFI surface
#       (every %foreign binds a decl there); backend-agnostic helpers
#       (get_rss_mb, create_seeded_index_array, ...) are ALSO declared in
#       their local header (shared_utils.h) so C consumers that include
#       only the local header still see them. The cross-header overlap is
#       intentional include-locality — declarations, not definitions.
#   readability-uppercase-literal-suffix — `0L` vs `0l` typo; rare
#       here
#   misc-use-anonymous-namespace — C++-only; prefers `namespace {}` over
#       file-scope `static` for internal linkage. The two are semantically
#       identical for free functions/variables, and `static` is the idiom
#       across this primarily-C codebase (the tape backend, C, can only
#       use `static` and is exempt by language). Firing only on the
#       torch/mlx C++ backends, it carries no bug-class signal — same
#       rationale as the modernize-*/cppcoreguidelines-* family disables.
#   misc-non-private-member-variables-in-classes — the backend tensor
#       handle (`struct Tensor` in backend_mlx/tensor.h, and the analogous
#       plain-data holders in the other backends) is a C-style aggregate:
#       all members public by design, mutated directly by the per-op .cpp
#       files and the lifecycle/tape machinery. It is a data record, not an
#       encapsulated class — privatising every field behind accessors would
#       add boilerplate and indirection with zero bug-class signal. Same
#       "stylistic, primarily-C codebase" rationale as the misc-use-anonymous
#       -namespace / misc-use-internal-linkage disables below.
#   misc-use-internal-linkage (clang-tidy 19+) — FALSE POSITIVE here:
#       suggests `static`/anon-namespace for symbols it sees no caller for
#       within the TU, but the flagged ones (from_tensor / from_tensor_
#       persistent declared in tensor.h and called from every per-op .cpp;
#       g_torch_target_device declared extern + read by dtype_dispatch.cpp)
#       are genuinely cross-TU — making them internal would break the link.
#       The check can't see header decls / external refs. Same family +
#       rationale as misc-use-anonymous-namespace above.
#
# Reference: https://clang.llvm.org/extra/clang-tidy/checks/list.html

Checks: >
  *,
  -abseil-*,
  -altera-*,
  -android-*,
  -boost-*,
  -clang-analyzer-optin.taint.*,
  -concurrency-*,
  -cppcoreguidelines-*,
  -darwin-*,
  -fuchsia-*,
  -google-*,
  -hicpp-*,
  -linuxkernel-*,
  -llvm-*,
  -llvmlibc-*,
  -modernize-*,
  -mpi-*,
  -objc-*,
  -openmp-*,
  -zircon-*,
  -bugprone-branch-clone,
  -bugprone-easily-swappable-parameters,
  -bugprone-multi-level-implicit-pointer-conversion,
  -bugprone-reserved-identifier,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -cert-err33-c,
  -cert-msc30-c,
  -cert-msc50-cpp,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-security.insecureAPI.rand,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  -misc-use-internal-linkage,
  -readability-braces-around-statements,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-inconsistent-declaration-parameter-name,
  -readability-isolate-declaration,
  -readability-magic-numbers,
  -readability-math-missing-parentheses,
  -readability-non-const-parameter,
  -readability-redundant-casting,
  -readability-redundant-declaration,
  -readability-uppercase-literal-suffix

WarningsAsErrors: '*'
HeaderFilterRegex: 'packages/backends/.*\.h$'
FormatStyle: file
