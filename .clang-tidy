# clang-tidy config for the C / C++ backend sources.
#
# Pattern: enable the whole `bugprone-*` family (it's curated as
# "bug-finding heuristics" — matches our intent), with two
# exceptions for checks that are stylistic rather than bug-class.
# Outside `bugprone-*`, enumerate individually — the other check
# families (readability-*, modernize-*, cppcoreguidelines-*, etc.)
# bundle real findings with broad style-preference enforcement we
# don't want.
#
# When LLVM ships a new bugprone-* check, we get it for free. When
# the new check turns out to be noisy here, add a negated entry
# below to disable it (mirror the pattern of the existing
# exceptions, with a rationale).
#
# To expand outside bugprone-*: add a check, run `make lint-c-tape`
# locally, decide whether the new findings are real (fix in source
# or guard with NOLINTNEXTLINE) or noisy (drop the entry).
#
# Reference: https://clang.llvm.org/extra/clang-tidy/checks/list.html

Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  cert-err34-c,
  clang-analyzer-deadcode.DeadStores,
  clang-analyzer-unix.Malloc,
  misc-definitions-in-headers,
  misc-redundant-expression,
  misc-unused-parameters,
  misc-unused-using-decls,
  readability-misleading-indentation,
  readability-redundant-control-flow

# bugprone-* exceptions, with rationale:
#   easily-swappable-parameters — tensor APIs are full of
#     `(int m, int n)` adjacent pairs by necessity; this check
#     would fire ~92 times across the backend with no
#     bug-class signal
#   reserved-identifier — `_var` is the local convention for
#     tape-internal helpers and statement-expression locals;
#     intentional, ~13 sites

WarningsAsErrors: '*'
HeaderFilterRegex: 'packages/backends/.*\.h$'
FormatStyle: file
