# test-convergence-ref threshold expectations (PyTorch reference side)
#
# Format: <module> <key> <op> <threshold>
# Same syntax as test-examples.expect — see that file's header for details.
# <module> is the torch_ref.scripts module name, so `supervised` here is the
# peer of `example-supervised` in test-examples-convergence.expect.
#
# Purpose: run the references at the same seeds and the same bars as the Idris
# convergence campaign, so the two pass rates answer the same question. Absent:
# the memory (ntm/dnc) and transformer models, whose Idris counterparts init
# from a normal distribution — a separate alignment axis from the dense-init
# contract this campaign measures (reference-alignment.md, "one dense init on
# both sides").
#
# Thresholds are copied from test-examples-convergence.expect unchanged. Where a
# row differs, the reason is stated inline.

# ---- Supervised / recurrent ----
supervised               loss         <   0.5
rnn                      loss         <   0.5
lstm                     loss         <   0.05
gru                      loss         <   0.05

# ---- Other non-RL ----
mnist                    accuracy     >=  0.85
# 0.5 is the reference's own bar from correctness/test_seq_classify.py, where
# chance is 0.33. Both sides evaluate 500 held-out samples.
seq_classify             accuracy     >=  0.5

# ---- RL: deep (CartPole + Acrobot + Pendulum + MountainCar) ----
reinforce                avg_return   >=  150
dqn                      avg_return   >=  100
double_dqn               avg_return   >=  100
mountain_car             avg_return   >=  -160
mountain_car_cont        avg_return   >=  85
a2c                      avg_return   >=  150
ppo                      avg_return   >=  -150
sac                      avg_return   >=  -500

# ---- RL: tabular ----
q_learning               avg_return   >=  -120
sarsa                    avg_return   >=  -120
monte_carlo              win_rate     >=  0.3
frozen_lake              avg_return   >=  0.4
taxi                     avg_return   >=  5
