.DS_Store
.tmp/

# Local git worktrees created by scripts/worktree.sh (each carries its
# own COW-cloned build/models/data trees; never commit them).
.worktrees/

# Generated per-build from HwConfig.idr.in + the BACKEND list (Makefile
# HWCONFIG_IDR rule). The template is tracked; the generated file is not.
packages/idris-ml/src/HwConfig.idr

# Generated per-build from HwExecutors.idr.in + the BACKEND list (Makefile
# HWEXECUTORS_IDR rule). The template is tracked; the generated file is not.
packages/idris-ml/src/HwExecutors.idr

# Generated per-build from Config.idr.in + the active PRIMARY × hw envs
# (Makefile TESTCONFIG_IDR rule). The template is tracked; the generated file
# is not.
packages/idris-ml/src/Test/Config.idr
packages/idris-transformers/src/Test/Config.idr

# Generated per-build from ML/Config.idr.in + the active PRIMARY × hw envs
# (Makefile MLCONFIG_IDR rule). The `ML.Simple` (Ex, F) pin; template tracked,
# generated file not.
packages/idris-ml/src/ML/Config.idr

build/
build-cov/
build-cov-*/
data/
# HF model checkpoints (and derived oracles) downloaded by
# `bash packages/idris-transformers/scripts/hf-download.sh <repo>` —
# materialised at the top level so Python's AutoModel.from_pretrained
# + Idris's loadModel share a single physical copy. Gigabytes per
# model, never checked in. Root-anchored — `torch_ref/models/` is a
# tracked Python package, not an HF cache.
/models/
.claude/
.idris2/

# direnv's local cache (created by `use flake` in .envrc); the .envrc
# itself is tracked, this generated cache dir is not.
.direnv/

# Vendored third-party deps — fetched on demand by `make vendor-deps`
# (auto-triggered when a SHARED_OBJ target needs the source). Pinned to
# a specific version + SHA256 in the Makefile. Excluded from VCS so
# upstream sources don't bloat clones or dominate LOC reports.
vendored/

.venv/
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
logs/
results/
reference/
.ipynb_checkpoints/
