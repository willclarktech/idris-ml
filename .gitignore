.DS_Store
.tmp/

# Generated per-build from HwConfig.idr.in + the BACKEND list (Makefile
# HWCONFIG_IDR rule). The template is tracked; the generated file is not.
packages/idris-ml/src/HwConfig.idr

# Generated per-build from HwDevices.idr.in + the BACKEND list (Makefile
# HWDEVICES_IDR rule). The template is tracked; the generated file is not.
packages/idris-ml/src/HwDevices.idr

# Generated per-build from TestConfig.idr.in + the active PRIMARY × hw envs
# (Makefile TESTCONFIG_IDR rule). The template is tracked; the generated file
# is not.
packages/idris-ml/test/src/TestConfig.idr

build/
build-cov/
data/
.claude/
.idris2/

# Vendored third-party deps — fetched on demand by `make vendor-deps`
# (auto-triggered when a SHARED_OBJ target needs the source). Pinned to
# a specific version + SHA256 in the Makefile. Excluded from VCS so
# upstream sources don't bloat clones or dominate LOC reports.
vendored/

.venv/
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
logs/
results/
reference/
.ipynb_checkpoints/
