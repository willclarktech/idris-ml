root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

[*.idr]
indent_size = 2
indent_style = space

[*.py]
indent_size = 4
indent_style = space

[*.{c,h,cpp,hpp}]
indent_size = 4
indent_style = tab

[*.{yml,yaml}]
indent_size = 2
indent_style = space

# Markdown: two trailing spaces is CommonMark's hard line break.
# Trimming them would silently corrupt the rendered output.
[*.md]
trim_trailing_whitespace = false
